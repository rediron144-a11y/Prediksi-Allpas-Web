function loadMegaPreset(pola, slot) {
  const raw = localStorage.getItem(`bbfs_master_${pola}_slot_${slot}`);
  if (!raw) { alert(`Slot PAKET ${slot} Pola ${pola} masih kosong!`); return; }
  const d = JSON.parse(raw);
  const pre = `${pola}_`;
  if (d.ops) {
    document.getElementById(pre + 'op_1').value = d.ops[0];
    document.getElementById(pre + 'op_2').value = d.ops[1];
    document.getElementById(pre + 'op_3').value = d.ops[2];
  }
  if (d.pangkal) document.getElementById(pre + 'mode_pangkal').value = d.pangkal;
  const patEl = document.getElementById(pre + 'pattern_step');
  if (patEl && d.patternStep) patEl.value = d.patternStep;
  for (let r = 1; r <= 10; r++) {
    ['as','cop','kepala','ekor'].forEach(pos => {
      const rData = d.rounds[r][pos];
      document.getElementById(`${pola}_in_r${r}_${pos}`).value = rData.val;
      document.getElementById(`${pola}_mode_r${r}_${pos}`).value = rData.mode;
      const sw = document.getElementById(`${pola}_sw_r${r}_${pos}`);
      const cell = document.getElementById(`${pola}_cell_r${r}_${pos}`);
      const input = document.getElementById(`${pola}_in_r${r}_${pos}`);
      if (rData.sw === 'OFF') {
        sw.innerText = 'OFF'; sw.classList.remove('on');
        cell.classList.add('cell-off'); input.disabled = true;
      } else {
        sw.innerText = 'ON'; sw.classList.add('on');
        cell.classList.remove('cell-off'); input.disabled = false;
      }
    });
  }
  highlightActive(pola, slot);
  runMegaFormula(pola);
}

