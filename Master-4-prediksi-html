function importJSON(event) {
  const file = event.target.files[0]; if (!file) return;
  const reader = new FileReader();
  reader.onload = function(e) {
    try {
      const imported = JSON.parse(e.target.result);
      if (typeof imported !== 'object' || Array.isArray(imported)) throw new Error('Format tidak valid.');
      let importedSumberList = [];
      if (Array.isArray(imported._sumberList)) { importedSumberList = imported._sumberList; delete imported._sumberList; }
      let newData = { mode: 'bbfs', sources: { '_default': { rows: [], mode: 'bbfs' } } };
      if (imported[currentPasaran]) newData = imported[currentPasaran];
      else { const keys = Object.keys(imported); if (keys.length > 0) newData = imported[keys[0]]; }
      if (newData.rows && !newData.sources) {
        const oldRows = newData.rows; const oldMode = newData.mode || 'bbfs'; const oldSumber = newData.sumber || '';
        newData = { mode: oldMode, sources: {} };
        const sourceKey = oldSumber || '_default';
        newData.sources[sourceKey] = { rows: oldRows, mode: oldMode };
      } else if (!newData.sources) newData = { mode: newData.mode || 'bbfs', sources: {} };
      if (newData.sources) {
        for (const s in newData.sources) {
          if (!newData.sources[s].mode) newData.sources[s].mode = newData.mode || 'bbfs';
          if (!newData.sources[s].rows) newData.sources[s].rows = [];
        }
      }
      if (confirm(`Data dari ${file.name} akan MENIMPA data saat ini. Lanjutkan?`)) {
        data = { [currentPasaran]: newData }; sumberList = importedSumberList;
        saveStorage(); saveSumberList();
        currentMode = getMode(); populateSumberDropdown();
        document.querySelectorAll('.mode-tabs .tab').forEach(el => el.classList.toggle('active', el.dataset.mode === currentMode));
        render(); alert('Impor berhasil!');
      }
    } catch (err) { alert('Gagal mengimpor: ' + err.message); }
    event.target.value = '';
  };
  reader.readAsText(file);
}

