    for (let b = 1; b <= 4; b++) tableHtml += `<th>${getColumnLabel(mode, b)}</th><th>Status ${b}</th>`;
    tableHtml += `</tr>`;
    for (let i = 0; i < n; i++) {
      const row = rows[i]; tableHtml += `<tr><td>${i + 1}</td><td>${row.result || ''}</td>`;
      for (let b = 1; b <= 4; b++) {
        const key = getKey(mode, b); const val = row[key] || '';
        let statusLabel = '—'; let statusCls = 'na';
        if (i === n - 1) { statusLabel = 'MENUNGGU'; statusCls = 'waiting'; }
        else { const nextResult = rows[i + 1]?.result; if (nextResult && nextResult.length >= 4) { const st = getStatus(mode, val, nextResult); statusLabel = st.label; statusCls = st.cls; } }
        tableHtml += `<td>${val}</td><td class="${statusCls}">${statusLabel}</td>`;
      }
      tableHtml += `</tr>`;
    }
    const stats = {1:{jp:0,test:0},2:{jp:0,test:0},3:{jp:0,test:0},4:{jp:0,test:0}};
    for (let i = 0; i < n - 1; i++) {
      const nextResult = rows[i + 1]?.result; if (!nextResult || nextResult.length < 4) continue;
      for (let b = 1; b <= 4; b++) { const key = getKey(mode, b); const inputValue = rows[i][key] || ''; if (!inputValue) continue; stats[b].test++; if (getStatus(mode, inputValue, nextResult).label === 'JP') stats[b].jp++; }
    }
    tableHtml += `<tr class="summary-row"><td colspan="2"><b>JP / Test</b></td>`;
    for (let b = 1; b <= 4; b++) tableHtml += `<td colspan="2"><b>${stats[b].jp} / ${stats[b].test}</b></td>`;
    tableHtml += `</tr></table></body></html>`;
    const blob = new Blob(['\uFEFF' + tableHtml], { type: 'application/vnd.ms-excel' });
    const url = URL.createObjectURL(blob); const a = document.createElement('a');
    a.href = url; a.download = `backtest_4predictor_${currentSumber || 'default'}_${new Date().toISOString().slice(0,10)}.xls`;
    document.body.appendChild(a); a.click();
    setTimeout(() => { document.body.removeChild(a); URL.revokeObjectURL(url); }, 100);
  } catch (err) { alert('Kesalahan ekspor Excel: ' + err.message); }
}

