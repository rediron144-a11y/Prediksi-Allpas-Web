function getMistik(num, mode) {
  if (mode === 'NORMAL') return parseInt(num) || 0;
  const c = parseInt(num) || 0;
  if (MISTIK_DATA[mode] && MISTIK_DATA[mode][c] !== undefined) return MISTIK_DATA[mode][c];
  return c;
}
function singleDigit(v) {
  v = Math.abs(v);
  if (v === 10) return 1;
  if (v === 11) return 2;
  while (v >= 10) { const s = v.toString(); v = parseInt(s[0]) + parseInt(s[1]); }
  return v;
}

function expandPatternToIntervals(deltas) {
  const intervals = [0];
  let cur = 0;
  for (let i = 0; i < 8; i++) {
    cur = cur + deltas[i % deltas.length];
    intervals.push(cur);
  }
  return intervals;
}
function getPatternIntervals(pola, patternKey) {
  if (!patternKey || patternKey === 'DEFAULT') return POLA_INTERVALS[pola];
  const pat = PATTERN_STEPS.find(p => p.id === patternKey);
  if (!pat) return POLA_INTERVALS[pola];
  return expandPatternToIntervals(pat.deltas);
}

