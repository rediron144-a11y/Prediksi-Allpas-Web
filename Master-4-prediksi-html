/* ==================== AUTO-SCAN PATTERN STEP ==================== */
function loadScanFromBacktest() {
  const rows = getRows();
  if (rows.length === 0) { alert('Belum ada data di backtest. Tambah baris dulu atau isi manual.'); return; }
  const values = rows.map(r => (r.result || '').trim()).filter(v => v.length === 4);
  if (values.length === 0) { alert('Tidak ada kolom Result yang terisi di backtest.'); return; }
  document.getElementById('scanInput').value = values.join('\n');
  alert(`✅ ${values.length} baris result berhasil diambil dari backtest.`);
}

function computeScanBBFS(pola, rounds, ops, pangkalMode, patternKey, tier) {
  let total = 0, first = true;
  for (let r = 0; r < 10; r++) {
    const rd = rounds[r];
    const items = [
      { v: rd.as,     op: ops[0] },
      { v: rd.cop,    op: ops[0] },
      { v: rd.kepala, op: ops[1] },
      { v: rd.ekor,   op: ops[2] }
    ];
    items.forEach(x => {
      if (first) { total = x.v; first = false; }
      else { total = x.op === '+' ? total + x.v : Math.abs(total - x.v); }
    });
  }
  const baseNormal = singleDigit(total);
  const p = getMistik(baseNormal, pangkalMode);
  const intervals = getPatternIntervals(pola, patternKey);
  const uniqueSet = new Set();
  intervals.forEach(step => uniqueSet.add(((p + step) % 10 + 10) % 10));
  return Array.from(uniqueSet).slice(0, tier);
}

function testScanPrediction(pola, bbfs, actualResult) {
  const kep = parseInt(actualResult[2]);
  const ekor = parseInt(actualResult[3]);
  if (pola === 'A') {
    let hits = 0;
    if (bbfs.includes(kep)) hits++;
    if (bbfs.includes(ekor)) hits++;
    return hits >= 2;
  }
  if (pola === 'B') return bbfs.includes(kep);
  if (pola === 'C') return bbfs.includes(ekor);
  if (pola === 'D') {
    const biji = hitungBiji2D(kep * 10 + ekor);
    return bbfs.includes(biji);
  }
  return false;
}

function runAutoScan() {
  const text = document.getElementById('scanInput').value;
  const lines = text.split(/\r?\n/).map(l => l.trim().replace(/\D/g, '')).filter(l => l.length === 4);

  if (lines.length < 15) {
    alert(`Data hanya ${lines.length} baris. Minimal 15 baris supaya bisa di-scan.\n\nIdealnya 40+ baris untuk 30 test.`);
    return;
  }

  const polaChecked = ['A','B','C','D'].filter(p => document.getElementById('scanChk' + p).checked);
  if (polaChecked.length === 0) { alert('Pilih minimal 1 pola untuk discan.'); return; }

  const btn = document.getElementById('btnScanNow');
  btn.disabled = true;
  btn.textContent = '⏳ Sedang scan...';

  setTimeout(() => {
    const totalTests = lines.length - 10;
    const results = {};

    polaChecked.forEach(pola => {
      const pre = pola + '_';
      const ops = [
        document.getElementById(pre + 'op_1').value,
        document.getElementById(pre + 'op_2').value,
        document.getElementById(pre + 'op_3').value
      ];
      const pangkalMode = document.getElementById(pre + 'mode_pangkal').value;

      const patternKeys = ['DEFAULT', ...PATTERN_STEPS.map(p => p.id)];
      const tiers = [4, 5, 6, 7, 8, 9];
      const combos = [];

      patternKeys.forEach(patKey => {
        tiers.forEach(tier => {
          let jp = 0, total = 0;
          for (let i = 10; i < lines.length; i++) {
            const rounds = [];
            for (let j = i - 10; j < i; j++) {
              const s = lines[j];
              rounds.push({ as: +s[0], cop: +s[1], kepala: +s[2], ekor: +s[3] });
            }
            const bbfs = computeScanBBFS(pola, rounds, ops, pangkalMode, patKey, tier);
            if (bbfs.length < tier) continue;
            total++;
            if (testScanPrediction(pola, bbfs, lines[i])) jp++;
          }
          if (total > 0) combos.push({ pattern: patKey, tier, jp, total, pct: (jp / total) * 100 });
        });
      });

      combos.sort((a, b) => b.pct - a.pct || b.jp - a.jp);
      results[pola] = combos;
    });

    renderScanResults(results, totalTests);
    btn.disabled = false;
    btn.textContent = '🚀 MULAI SCAN SEMUA PATTERN';
  }, 50);
}

function renderScanResults(results, totalTests) {
  const container = document.getElementById('scanResultArea');
  const polaNames = { A: 'POLA A — BBFS', B: 'POLA B — KEPALA', C: 'POLA C — EKOR', D: 'POLA D — BIJI ON' };
  const testDesc = {
    A: 'Test: 2 dari {Kepala, Ekor} result muncul di BBFS',
    B: 'Test: digit Kepala result muncul di BBFS',
    C: 'Test: digit Ekor result muncul di BBFS',
    D: 'Test: Biji 2D result muncul di BBFS'
  };

  let html = `<div class="scan-info">📊 Total <b>${totalTests}</b> test per kombinasi (pattern × tier) &nbsp;|&nbsp; Total baris: <b>${totalTests + 10}</b></div>`;

  Object.keys(results).forEach(pola => {
    const combos = results[pola].slice(0, 10);
    if (combos.length === 0) {
      html += `<div class="scan-card"><h4>${polaNames[pola]}</h4><div class="scan-empty">Tidak ada hasil.</div></div>`;
      return;
    }
    html += `<div class="scan-card">
      <h4>${polaNames[pola]}</h4>
      <div class="sub-desc">${testDesc[pola]}</div>
      <table class="scan-table">
        <thead><tr><th>#</th><th>Pattern Step</th><th>Tier</th><th>JP</th><th>Test</th><th>Akurasi</th><th>Aksi</th></tr></thead>
        <tbody>`;
    combos.forEach((c, idx) => {
      const rankCls = idx < 3 ? `rank${idx+1}` : '';
      const pctCls = c.pct >= 70 ? 'pct-high' : c.pct >= 50 ? 'pct-mid' : 'pct-low';
      const patLabel = c.pattern === 'DEFAULT'
        ? `DEFAULT ${pola}`
        : (PATTERN_STEPS.find(p => p.id === c.pattern)?.label || c.pattern);
      html += `<tr class="${rankCls}">
        <td>${idx + 1}</td>
        <td style="text-align:left;font-family:'Courier New',monospace;font-weight:800;">${patLabel}</td>
        <td>${c.tier}D</td>
        <td>${c.jp}</td>
        <td>${c.total}</td>
        <td class="${pctCls}">${c.pct.toFixed(1)}%</td>
        <td><button class="btn-apply-pat" onclick="applyScanPattern('${pola}','${c.pattern}','${c.tier}')">PAKAI</button></td>
      </tr>`;
    });
    html += `</tbody></table></div>`;
  });

  container.innerHTML = html;
}

function applyScanPattern(pola, patternKey, tier) {
  const pre = pola + '_';
  const patEl = document.getElementById(pre + 'pattern_step');
  if (patEl) patEl.value = patternKey;

  const tierEl = document.getElementById('tierTarik');
  if (tierEl) tierEl.value = tier;

  runMegaFormula(pola);

  const patLabel = patternKey === 'DEFAULT' ? `DEFAULT ${pola}` : (PATTERN_STEPS.find(p => p.id === patternKey)?.label || patternKey);
  alert(`✅ Diterapkan ke Pola ${pola}:\n\nPattern: ${patLabel}\nTier: ${tier}D\n\nBuka tab Pola ${pola} untuk lihat prediksi terbaru.`);

  switchTab(pola);
}

