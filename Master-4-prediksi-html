<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MASTER 4 PREDICTOR + AUTO-SCAN - Premium 10R</title>
<style>
:root {
  --bg-main: #eef2f7; --bg-card: #ffffff; --bg-soft: #f8fafc; --bg-input: #ffffff;
  --primary: #d97706; --primary-soft: #fef3c7; --primary-border: #fbbf24;
  --secondary: #0891b2; --secondary-soft: #cffafe;
  --text-main: #1e293b; --text-muted: #64748b;
  --border-color: #cbd5e1; --border-soft: #e2e8f0;
  --accent-as: #dc2626; --accent-cop: #16a34a; --accent-kepala: #2563eb; --accent-ekor: #ea580c;
  --shadow-sm: 0 2px 6px rgba(15,23,42,0.06); --shadow-md: 0 4px 14px rgba(15,23,42,0.08);
  --shadow-lg: 0 10px 30px rgba(15,23,42,0.10);
}
* { box-sizing: border-box; font-family: 'Segoe UI', system-ui, sans-serif; transition: all 0.15s ease-in-out; }
body { background: var(--bg-main); color: var(--text-main); margin: 0; padding: 12px; display: flex; flex-direction: column; align-items: center; min-height: 100vh; }
.container { width: 100%; max-width: 700px; background: var(--bg-card); border: 1px solid var(--border-soft); border-radius: 14px; padding: 14px; box-shadow: var(--shadow-lg); }
h1 { text-align: center; font-size: 15px; text-transform: uppercase; letter-spacing: 1px; margin: 4px 0 12px 0; color: var(--text-main); font-weight: 800; }
h1 span { color: var(--primary); }
.global-bar { display: flex; align-items: center; gap: 8px; background: var(--primary-soft); border: 1px solid var(--primary-border); border-radius: 8px; padding: 8px 10px; margin-bottom: 10px; }
.global-bar label { font-size: 10px; font-weight: 800; color: #92400e; letter-spacing: 0.5px; white-space: nowrap; }
.global-bar input { flex: 1; height: 32px; background: #fff; border: 1px solid var(--primary-border); color: var(--text-main); border-radius: 6px; padding: 0 10px; font-weight: 700; text-transform: uppercase; font-size: 12px; outline: none; }
.global-bar input:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(217,119,6,0.15); }
.tab-bar { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; background: var(--bg-soft); padding: 4px; border-radius: 10px; border: 1px solid var(--border-soft); margin-bottom: 12px; }
.tab { padding: 10px 4px; background: transparent; border: none; color: var(--text-muted); font-weight: 800; font-size: 10px; border-radius: 6px; cursor: pointer; letter-spacing: 0.3px; text-transform: uppercase; }
.tab:hover { background: rgba(217,119,6,0.08); color: var(--primary); }
.tab.active { background: var(--primary); color: #fff; box-shadow: 0 2px 8px rgba(217,119,6,0.35); }
.tab.tab-compare { color: var(--secondary); } .tab.tab-compare.active { background: var(--secondary); color: #fff; }
.tab.tab-backtest { color: #16a34a; } .tab.tab-backtest.active { background: #16a34a; color: #fff; }
.tab.tab-scan { color: #0284c7; } .tab.tab-scan.active { background: #0284c7; color: #fff; }
.panel { display: none; } .panel.active { display: block; }
.panel-title { font-size: 13px; font-weight: 800; letter-spacing: 1px; margin: 0 0 10px 0; padding-bottom: 6px; border-bottom: 2px solid var(--primary-soft); color: var(--primary); text-align: center; text-transform: uppercase; }
.preset-row { display: flex; gap: 5px; margin-bottom: 10px; }
.btn-pkt { flex: 1; height: 38px; background: var(--bg-soft); border: 1px solid var(--border-color); border-radius: 7px; color: var(--text-main); font-size: 10px; font-weight: 700; cursor: pointer; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 1px; }
.btn-pkt:hover { border-color: var(--primary); background: var(--primary-soft); }
.btn-pkt.active { border-color: var(--primary); color: var(--primary); background: var(--primary-soft); }
.btn-pkt .save-txt { font-size: 8px; color: var(--secondary); font-weight: 900; }
.btn-pkt.btn-danger { border-color: #fca5a5; color: #dc2626; }
.btn-pkt.btn-danger:hover { background: #fef2f2; border-color: #dc2626; }
.btn-pkt.btn-danger .save-txt { color: #dc2626; }
.bulk-panel { background: linear-gradient(180deg, #fffbeb, #fef9e7); border: 1px dashed var(--primary-border); border-radius: 10px; padding: 10px; margin-bottom: 12px; }
.bulk-panel label { display: block; font-size: 10px; font-weight: 800; color: #92400e; letter-spacing: 0.5px; margin-bottom: 6px; text-transform: uppercase; }
.bulk-panel label span { color: var(--secondary); }
.bulk-panel textarea { width: 100%; background: #fff; border: 1px solid var(--primary-border); color: var(--text-main); border-radius: 7px; padding: 10px; font-family: 'Courier New', monospace; font-size: 15px; letter-spacing: 4px; font-weight: 700; resize: vertical; outline: none; min-height: 110px; line-height: 1.5; }
.bulk-panel textarea:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(217,119,6,0.15); }
.bulk-panel textarea::placeholder { color: #cbd5e1; letter-spacing: 3px; }
.btn-bulk { width: 100%; margin-top: 8px; padding: 12px; background: linear-gradient(135deg, var(--secondary), #0e7490); color: #fff; border: none; border-radius: 7px; font-size: 12px; font-weight: 900; cursor: pointer; letter-spacing: 1.2px; text-transform: uppercase; box-shadow: 0 3px 10px rgba(8,145,178,0.30); }
.btn-bulk:hover { background: linear-gradient(135deg, #06b6d4, var(--secondary)); transform: translateY(-1px); }
.rounds-container { display: flex; flex-direction: column; gap: 7px; margin-bottom: 12px; }
.round-row { background: var(--bg-soft); border: 1px solid var(--border-soft); border-radius: 8px; padding: 6px 8px; }
.round-row.latest { border-color: var(--primary-border); box-shadow: 0 0 0 2px rgba(217,119,6,0.12); background: linear-gradient(180deg, #fffbeb, #fff7e0); }
.round-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px; padding-bottom: 3px; border-bottom: 1px dashed var(--border-soft); }
.round-badge { font-size: 10px; font-weight: 800; color: var(--text-muted); padding: 1px 8px; background: #fff; border-radius: 4px; border: 1px solid var(--border-soft); }
.round-row.latest .round-badge { color: #fff; background: var(--primary); border-color: var(--primary); }
.pos-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 5px; }
.pos-cell { display: flex; flex-direction: column; gap: 3px; background: #fff; padding: 5px; border-radius: 6px; border: 1px solid var(--border-soft); }
.cell-top { display: flex; justify-content: space-between; align-items: center; gap: 2px; }
.cell-label { font-size: 9px; font-weight: 900; }
.lbl-as { color: var(--accent-as); } .lbl-cop { color: var(--accent-cop); } .lbl-kep { color: var(--accent-kepala); } .lbl-ekor { color: var(--accent-ekor); }
.sw-mini { background: #fff; border: 1px solid #fca5a5; color: #dc2626; font-size: 8px; font-weight: 900; padding: 1px 4px; border-radius: 3px; cursor: pointer; outline: none; }
.sw-mini.on { border-color: #86efac; color: #16a34a; background: #f0fdf4; }
.in-digit { width: 100%; height: 28px; text-align: center; font-size: 16px; font-weight: 900; background: #fff; border: 1px solid var(--border-color); color: var(--text-main); border-radius: 5px; outline: none; }
.in-digit:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(217,119,6,0.15); }
.in-digit:disabled { opacity: 0.25; background: #f1f5f9; border-color: var(--border-soft); }
.sel-pola-mini { width: 100%; font-size: 9px; font-weight: 700; background: var(--bg-soft); color: var(--text-main); border: 1px solid var(--border-soft); border-radius: 4px; height: 20px; outline: none; cursor: pointer; }
.cell-off { opacity: 0.45; }
.config-row { display: flex; align-items: center; justify-content: space-between; background: var(--bg-soft); padding: 10px; border-radius: 8px; border: 1px solid var(--border-soft); gap: 10px; margin-bottom: 12px; flex-wrap: wrap; }
.op-group, .pangkal-group { display: flex; align-items: center; gap: 5px; }
.op-lbl { font-size: 9px; font-weight: 800; color: var(--text-muted); text-transform: uppercase; }
.op-sel { background: #fff; color: var(--primary); border: 1px solid var(--primary-border); padding: 4px 6px; border-radius: 5px; font-weight: 900; font-size: 12px; outline: none; cursor: pointer; }
.sel-pangkal { background: #fff; color: var(--secondary); border: 1px solid var(--secondary); padding: 4px 6px; border-radius: 5px; font-size: 11px; font-weight: 800; outline: none; cursor: pointer; }
.btn-calc { width: 100%; padding: 13px; background: linear-gradient(135deg, var(--primary), #b45309); color: #fff; border: none; border-radius: 7px; font-size: 13px; font-weight: 900; cursor: pointer; letter-spacing: 1px; text-transform: uppercase; box-shadow: 0 4px 12px rgba(217,119,6,0.30); }
.btn-calc:hover { background: linear-gradient(135deg, #f59e0b, var(--primary)); transform: translateY(-1px); }
.result-panel { margin-top: 12px; background: var(--bg-soft); border: 1px solid var(--border-soft); border-radius: 10px; padding: 12px; }
.res-hdr { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px dashed var(--border-color); padding-bottom: 8px; margin-bottom: 10px; }
.res-title { font-size: 10px; font-weight: 800; color: var(--text-muted); text-transform: uppercase; }
.res-pasaran { font-size: 12px; font-weight: 900; color: var(--primary); text-transform: uppercase; }
.out-row { display: flex; align-items: center; gap: 8px; background: #fff; padding: 6px 8px; border-radius: 6px; margin-bottom: 5px; border: 1px solid var(--border-soft); }
.out-pangkat { font-size: 10px; font-weight: 800; color: var(--secondary); width: 92px; text-transform: uppercase; text-align: center; border-right: 1px solid var(--border-soft); padding-right: 6px; flex-shrink: 0; }
.out-boxes { display: flex; gap: 4px; flex-wrap: wrap; }
.box-num { width: 28px; height: 28px; line-height: 26px; text-align: center; background: #f8fafc; border: 1px solid var(--border-color); color: var(--text-main); font-size: 13px; font-weight: 900; border-radius: 5px; }
.out-row.top-tier { background: linear-gradient(135deg, #fffbeb, #fef3c7); border-color: var(--primary-border); }
.out-row.top-tier .out-pangkat { color: #92400e; font-weight: 900; }
.out-row.top-tier .box-num { background: var(--primary); border-color: #b45309; color: #fff; box-shadow: 0 2px 6px rgba(217,119,6,0.30); }
.indicator-panel { margin-top: 10px; background: #fff; border: 1px dashed var(--primary-border); border-radius: 8px; padding: 10px; text-align: center; }
.ind-hdr { font-size: 10px; font-weight: 900; color: var(--primary); letter-spacing: 0.8px; margin-bottom: 6px; text-transform: uppercase; }
.ind-body { font-size: 13px; font-weight: 800; color: var(--text-main); display: flex; justify-content: center; align-items: center; gap: 5px; flex-wrap: wrap; line-height: 1.7; }
.ind-badge-part { background: var(--bg-soft); padding: 2px 7px; border-radius: 5px; border: 1px solid var(--border-color); color: var(--text-main); font-size: 11px; }
.ind-badge-part.as-style { border-color: #fca5a5; color: var(--accent-as); background: #fef2f2; }
.ind-badge-part.cop-style { border-color: #86efac; color: var(--accent-cop); background: #f0fdf4; }
.ind-badge-part.kep-style { border-color: #93c5fd; color: var(--accent-kepala); background: #eff6ff; }
.ind-badge-part.ekor-style { border-color: #fdba74; color: var(--accent-ekor); background: #fff7ed; }
.ind-op { color: var(--primary); font-weight: 900; padding: 0 1px; font-size: 14px; }
.pattern-row { background: linear-gradient(135deg, #ecfeff, #cffafe); border: 2px solid var(--secondary); border-radius: 10px; padding: 10px 12px; margin-bottom: 10px; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
.pattern-row .pattern-label { font-size: 10px; font-weight: 900; color: #0e7490; text-transform: uppercase; letter-spacing: 0.6px; white-space: nowrap; }
.pattern-row select { flex: 1; min-width: 150px; background: #fff; border: 1px solid var(--secondary); color: #0e7490; padding: 6px 10px; border-radius: 6px; font-size: 12px; font-weight: 800; outline: none; cursor: pointer; }
.pattern-row select:focus { box-shadow: 0 0 0 3px rgba(8,145,178,0.20); }
.prediksi-box { background: linear-gradient(135deg, #fef3c7, #fde68a); border: 2px solid var(--primary); border-radius: 10px; padding: 10px 12px; margin-bottom: 10px; text-align: center; }
.prediksi-box .prediksi-label { font-size: 10px; font-weight: 900; color: #92400e; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 4px; }
.prediksi-box .prediksi-value { font-size: 26px; font-weight: 900; color: var(--primary); letter-spacing: 4px; font-family: 'Courier New', monospace; text-shadow: 0 1px 2px rgba(217,119,6,0.25); line-height: 1.1; }
.prediksi-box .prediksi-sub { font-size: 10px; font-weight: 700; color: #92400e; margin-top: 4px; }
.btn-tarik-pola { width: 100%; margin-top: 10px; padding: 11px; background: linear-gradient(135deg, #f59e0b, #d97706); color: #fff; border: none; border-radius: 7px; font-size: 11px; font-weight: 900; cursor: pointer; letter-spacing: 1px; text-transform: uppercase; box-shadow: 0 3px 10px rgba(245,158,11,0.35); }
.btn-tarik-pola:hover { transform: translateY(-1px); background: linear-gradient(135deg, #fbbf24, #f59e0b); }
.compare-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin-bottom: 12px; }
.compare-card { background: #fff; border: 2px solid var(--border-soft); border-radius: 10px; padding: 10px; }
.compare-card.pola-A { border-color: #fbbf24; } .compare-card.pola-B { border-color: #34d399; }
.compare-card.pola-C { border-color: #60a5fa; } .compare-card.pola-D { border-color: #f472b6; }
.compare-title { font-size: 11px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.8px; text-align: center; margin-bottom: 8px; padding-bottom: 6px; border-bottom: 1px dashed var(--border-soft); }
.compare-card.pola-A .compare-title { color: #b45309; } .compare-card.pola-B .compare-title { color: #047857; }
.compare-card.pola-C .compare-title { color: #1d4ed8; } .compare-card.pola-D .compare-title { color: #be185d; }
.compare-row { display: flex; align-items: center; gap: 6px; margin-bottom: 5px; }
.compare-label { font-size: 9px; font-weight: 800; color: var(--text-muted); width: 34px; text-align: right; flex-shrink: 0; }
.compare-boxes { display: flex; gap: 3px; flex-wrap: wrap; }
.cmp-box { width: 22px; height: 22px; line-height: 20px; text-align: center; background: var(--bg-soft); border: 1px solid var(--border-color); color: var(--text-main); font-size: 11px; font-weight: 900; border-radius: 4px; }
.cmp-box.top4 { background: var(--primary); border-color: #b45309; color: #fff; box-shadow: 0 2px 5px rgba(217,119,6,0.30); }
.iris-panel { background: linear-gradient(135deg, #ecfeff, #cffafe); border: 2px solid var(--secondary); border-radius: 10px; padding: 12px; text-align: center; }
.iris-title { font-size: 11px; font-weight: 900; color: #0e7490; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 8px; }
.iris-body { display: flex; justify-content: center; gap: 5px; flex-wrap: wrap; min-height: 32px; align-items: center; }
.iris-box { width: 32px; height: 32px; line-height: 30px; text-align: center; background: #fff; border: 2px solid var(--secondary); color: #0e7490; font-size: 15px; font-weight: 900; border-radius: 6px; box-shadow: 0 2px 5px rgba(8,145,178,0.20); }
.iris-empty { color: var(--text-muted); font-size: 11px; font-style: italic; }

/* ============ AUTO-SCAN PANEL ============ */
.scan-panel { background: linear-gradient(180deg, #f0f9ff, #e0f2fe); border: 2px solid #0284c7; border-radius: 10px; padding: 12px; margin-bottom: 12px; }
.scan-panel h3 { margin: 0 0 10px 0; font-size: 12px; color: #075985; text-transform: uppercase; font-weight: 900; letter-spacing: 1px; }
.scan-panel label { display: block; font-size: 10px; font-weight: 800; color: #075985; margin-bottom: 5px; text-transform: uppercase; }
.scan-panel textarea { width: 100%; min-height: 160px; padding: 10px; font-family: 'Courier New', monospace; font-size: 14px; font-weight: 700; letter-spacing: 3px; border: 1px solid #0284c7; border-radius: 7px; outline: none; resize: vertical; background: #fff; color: #0c4a6e; line-height: 1.6; }
.scan-panel textarea:focus { box-shadow: 0 0 0 3px rgba(2,132,199,0.20); }
.scan-panel textarea::placeholder { color: #94a3b8; letter-spacing: 2px; }
.scan-options { display: flex; gap: 12px; flex-wrap: wrap; margin: 10px 0; align-items: center; }
.scan-options .opt-group { display: flex; align-items: center; gap: 5px; flex-wrap: wrap; }
.scan-options .opt-group label { margin: 0; font-size: 10px; }
.scan-options .chk { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 800; color: #075985; cursor: pointer; padding: 4px 8px; background: #fff; border: 1px solid #0284c7; border-radius: 5px; }
.scan-options .chk input { cursor: pointer; margin: 0; }
.btn-scan { width: 100%; padding: 13px; background: linear-gradient(135deg, #0284c7, #0369a1); color: #fff; border: none; border-radius: 7px; font-size: 13px; font-weight: 900; cursor: pointer; letter-spacing: 1px; text-transform: uppercase; box-shadow: 0 4px 12px rgba(2,132,199,0.30); margin-top: 6px; }
.btn-scan:hover { transform: translateY(-1px); background: linear-gradient(135deg, #0ea5e9, #0284c7); }
.btn-scan:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
.btn-load-bt { width: 100%; padding: 9px; background: linear-gradient(135deg, #7c3aed, #6d28d9); color: #fff; border: none; border-radius: 7px; font-size: 11px; font-weight: 800; cursor: pointer; letter-spacing: 1px; text-transform: uppercase; margin-top: 6px; box-shadow: 0 3px 8px rgba(124,58,237,0.30); }
.btn-load-bt:hover { transform: translateY(-1px); background: linear-gradient(135deg, #8b5cf6, #7c3aed); }
.scan-result { margin-top: 12px; }
.scan-card { background: #fff; border: 2px solid #0284c7; border-radius: 10px; padding: 12px; margin-bottom: 12px; }
.scan-card h4 { margin: 0 0 8px 0; font-size: 12px; color: #075985; text-transform: uppercase; font-weight: 900; border-bottom: 1px dashed #bae6fd; padding-bottom: 5px; }
.scan-card .sub-desc { font-size: 10px; color: #64748b; margin-bottom: 8px; font-style: italic; font-weight: 700; }
.scan-table { width: 100%; border-collapse: collapse; font-size: 11px; }
.scan-table th { background: #075985; color: #fff; padding: 6px 4px; font-size: 9px; text-transform: uppercase; letter-spacing: 0.3px; }
.scan-table td { padding: 5px 4px; text-align: center; border-bottom: 1px solid #e2e8f0; font-weight: 700; color: #0f172a; font-size: 11px; }
.scan-table tr:hover td { background: #f0f9ff; }
.scan-table .rank1 td { background: #fef3c7; font-weight: 900; }
.scan-table .rank2 td { background: #fef9c3; }
.scan-table .rank3 td { background: #fefce8; }
.scan-table .pct-high { color: #15803d; font-weight: 900; }
.scan-table .pct-mid { color: #b45309; font-weight: 800; }
.scan-table .pct-low { color: #b91c1c; font-weight: 700; }
.btn-apply-pat { padding: 3px 8px; background: #16a34a; color: #fff; border: none; border-radius: 4px; font-size: 9px; font-weight: 800; cursor: pointer; letter-spacing: 0.3px; }
.btn-apply-pat:hover { background: #15803d; }
.scan-info { font-size: 11px; color: #075985; font-weight: 800; padding: 8px 10px; background: #f0f9ff; border: 1px dashed #0284c7; border-radius: 6px; margin-bottom: 10px; text-align: center; }
.scan-empty { text-align: center; color: #64748b; font-size: 11px; font-style: italic; padding: 20px; }

@media (max-width: 700px) {
  .tab-bar { grid-template-columns: repeat(4, 1fr); }
  .tab { font-size: 9px; padding: 8px 2px; }
}
@media (max-width: 480px) {
  .tab { font-size: 8px; padding: 8px 2px; }
  .out-pangkat { width: 78px; font-size: 9px; }
  .box-num { width: 25px; height: 25px; line-height: 23px; font-size: 12px; }
  .compare-grid { grid-template-columns: 1fr; }
  .tab-bar { grid-template-columns: repeat(3, 1fr); }
}

#panel_BACKTEST * { box-sizing: border-box; }
#panel_BACKTEST { --bg:#FFC107;--surface:#FFB300;--card:#FFA000;--accent:#000080;--accent2:#0000CD;--text:#000040;--muted:#1A237E;--danger:#8B0000;--success:#006400;--border:#B8860B;--input-bg:#FFF8E1;--waiting:#F57F17;--radius:10px; }
#panel_BACKTEST .app { max-width:100%; width:100%; margin:0 auto; background:var(--surface); border-radius:var(--radius); padding:16px 18px 22px; border:2px solid var(--border); box-shadow:0 8px 30px rgba(0,0,0,0.3); }
#panel_BACKTEST .bt-title { text-align:center; color:var(--accent); font-size:18px; letter-spacing:2px; text-transform:uppercase; border-bottom:3px solid var(--accent); padding-bottom:10px; margin:0 0 18px 0; font-weight:800; }
#panel_BACKTEST .bt-title small { display:block; font-size:11px; color:var(--muted); letter-spacing:1px; font-weight:600; text-transform:none; margin-top:4px; }
#panel_BACKTEST .top-bar { display:flex; flex-wrap:wrap; gap:12px; align-items:center; margin-bottom:16px; background:var(--card); padding:10px 14px; border-radius:8px; border:1px solid var(--border); }
#panel_BACKTEST .top-bar label { font-size:13px; color:var(--muted); font-weight:700; display:flex; align-items:center; gap:6px; }
#panel_BACKTEST .top-bar select, #panel_BACKTEST .top-bar input { background:var(--input-bg); border:1px solid var(--border); color:var(--text); padding:6px 12px; border-radius:6px; font-size:13px; outline:none; font-weight:600; }
