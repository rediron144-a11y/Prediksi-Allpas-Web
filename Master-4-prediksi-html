      document.getElementById(pre + 'op_2').value,
      document.getElementById(pre + 'op_3').value
    ],
    pangkal: document.getElementById(pre + 'mode_pangkal').value,
    patternStep: document.getElementById(pre + 'pattern_step')?.value || 'DEFAULT',
    rounds: {}
  };
  for (let r = 1; r <= 10; r++) {
    megaData.rounds[r] = {};
    ['as','cop','kepala','ekor'].forEach(pos => {
      megaData.rounds[r][pos] = {
        sw: document.getElementById(`${pola}_sw_r${r}_${pos}`).innerText,
        val: document.getElementById(`${pola}_in_r${r}_${pos}`).value,
        mode: document.getElementById(`${pola}_mode_r${r}_${pos}`).value
