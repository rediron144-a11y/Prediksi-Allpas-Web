  const input = document.getElementById(`${pola}_in_r${r}_${pos}`);
  if (sw.innerText === 'ON') {
    sw.innerText = 'OFF'; sw.classList.remove('on');
    cell.classList.add('cell-off'); input.disabled = true;
  } else {
    sw.innerText = 'ON'; sw.classList.add('on');
    cell.classList.remove('cell-off'); input.disabled = false;
  }
  runMegaFormula(pola);
}

function kirimKeBox(pola) {
  const raw = document.getElementById('bulk_' + pola).value;
  let lines = raw.split(/\r?\n/).map(l => l.trim()).filter(l => l.length >= 4);
  if (lines.length === 0) { alert('Bosq, isi dulu minimal 1 baris data 4 digit!'); return; }
  if (lines.length > 10) { alert('Data lebih dari 10 baris. Hanya 10 baris pertama diproses.'); lines = lines.slice(0, 10); }
  for (let i = 0; i < lines.length; i++) {
    const digits = lines[i].replace(/\D/g, '').split('');
    if (digits.length < 4) continue;
    const r = 10 - i;
    if (r < 1) break;
    setCellValue(pola, r, 'as', digits[0]);
    setCellValue(pola, r, 'cop', digits[1]);
    setCellValue(pola, r, 'kepala', digits[2]);
    setCellValue(pola, r, 'ekor', digits[3]);
  }
  runMegaFormula(pola);
}

function setCellValue(pola, r, pos, val) {
  const input = document.getElementById(`${pola}_in_r${r}_${pos}`);
  const sw = document.getElementById(`${pola}_sw_r${r}_${pos}`);
  const cell = document.getElementById(`${pola}_cell_r${r}_${pos}`);
  if (!input || !sw || !cell) return;
  input.value = val;
  if (sw.innerText === 'OFF') {
    sw.innerText = 'ON'; sw.classList.add('on');
    cell.classList.remove('cell-off'); input.disabled = false;
  }
}

function saveMegaPreset(pola, slot, e) {
  e.stopPropagation();
  const pre = `${pola}_`;
  const megaData = {
    ops: [
